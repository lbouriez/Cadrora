# Public Vite variables only. Never put secrets in VITE_* variables.
# AUTH_PEPPER, ADMIN_SECRET_HASH, and TURNSTILE_SECRET_KEY belong in Worker
# secret storage or the ignored local .dev.vars file, never in this file.
VITE_APP_NAME=Cadrora
VITE_SITE_DEFAULT_LANG=fr
VITE_PHOTOGRAPHER_NAME=
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_ADDRESS=
VITE_SERVICE_AREA=
# Configure an optional GA4 measurement ID in Admin > Site settings > Website.
VITE_TURNSTILE_SITE_KEY=
